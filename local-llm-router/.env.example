# Copy to .env and fill values. Never commit .env or real secrets.

# LiteLLM
LITELLM_VERSION=v1.90.5
LITELLM_MASTER_KEY=change-me-to-a-random-value-at-least-32-bytes-long
# Keep stable across upgrades/rollbacks (required for encrypted credentials in DB)
# LITELLM_SALT_KEY=

# Phase 7+: register custom shared-quota routing (module:function)
LITELLM_WORKER_STARTUP_HOOKS=shared_quota_router.bootstrap:register_proxy_startup

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# PostgreSQL — only for compose profile "full".
# Leave DATABASE_URL unset/commented for core profile (M0 without Postgres).
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=litellm
# DATABASE_URL=postgresql://litellm:change-me-postgres-password@postgres:5432/litellm

# Upstream OpenCode Go
# Chat (legacy / future): .../zen/go/v1
OPENCODE_GO_BASE_URL=https://example.invalid/v1
# Anthropic Messages (interim public): LiteLLM appends /v1/messages — no trailing /v1
OPENCODE_GO_ANTHROPIC_BASE_URL=https://example.invalid
OPENCODE_GO_KEY_A=
OPENCODE_GO_KEY_B=

# Upstream Volcengine Coding Plan
# Chat (legacy / future): .../api/coding/v3
VOLC_CODING_BASE_URL=https://example.invalid/api/coding/v3
# Anthropic Messages (interim public): .../api/coding  (NOT /v3)
VOLC_CODING_ANTHROPIC_BASE_URL=https://example.invalid/api/coding
VOLC_CODING_KEY_C=

# NewAPI (Anthropic Messages; base without /v1)
PLAN_NEWAPI_A_BASE_URL=https://example.invalid
PLAN_NEWAPI_A_API_KEY=

# Official DeepSeek — https://api-docs.deepseek.com/zh-cn/
# Chat base keeps /v1 (LiteLLM appends /chat/completions)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Anthropic base has no trailing /v1 (LiteLLM appends /v1/messages)
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=

# Official MiniMax Anthropic — https://platform.minimaxi.com/docs/api-reference/text-anthropic-api
# China: https://api.minimaxi.com/anthropic  |  International: https://api.minimax.io/anthropic
MINIMAX_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_API_KEY=

# --- Protocol-aware gateway ---
# Interim: public Anthropic direct; conversion OFF until multi-route convert epic.
PROTOCOL_AWARE_GATEWAY_ENABLED=true
PROTOCOL_CONVERSION_ENABLED=false
SHARED_QUOTA_ENV_PROFILE=staging
# SHARED_QUOTA_PRODUCTION_APPROVED_DIRECTIONS=
# SHARED_QUOTA_METRICS_LABEL_SALT=
# SHARED_QUOTA_METRICS_RAW_LABELS=false

# Docker: logical_models SoT from mounted litellm config
# SHARED_QUOTA_LITELLM_YAML=/app/config.yaml
# Import-time native Messages��Chat (must match apply --enable-messages-chat-native)
# LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES=true

